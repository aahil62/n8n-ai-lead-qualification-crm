      "id": "p1-intake-call-crm",
      "name": "Call CRM Handoff",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        2200,
        -360
      ],
      "notes": "After import, bind this node to P1-03 CRM Handoff workflow ID. Only called for deal_eligible (qualified) leads; existing_customer/spam/low-confidence never reach this node."
    },
    {
      "parameters": {
        "jsCode": "const incoming = $input.first().json;\nlet merged = incoming;\nif (incoming.outcome !== 'duplicate' && incoming.deal_eligible !== false) {\n  const crm = $('Call CRM Handoff').first().json || {};\n  merged = { ...incoming, crm_handoff: crm };\n}\nlet final_status = 'no_crm_handoff';\nif (merged.outcome === 'duplicate') final_status = 'duplicate_no_action';\nelse if (merged.crm_sync_status === 'synced' || merged.outcome === 'crm_handoff_success') final_status = 'crm_handoff_complete';\nelse if (merged.crm_sync_status === 'failed' || merged.outcome === 'crm_handoff_failed') final_status = 'crm_handoff_failed';\nreturn [{ json: { ...merged, final_status } }];"
      },
