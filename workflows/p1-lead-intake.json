        "jsCode": "const rec = $('Dedup Check').first().json;\nconst fields = rec.fields || rec;\nconst lead = $('Validate & Build Canonical Lead').item.json.lead;\nreturn [{\n  json: {\n    outcome: 'duplicate',\n    lead_id: rec.id || fields.lead_id || '',\n    correlation_id: fields.correlation_id || lead.correlation_id,\n    idempotency_key: fields.idempotency_key || lead.idempotency_key,\n    qualification_status: fields.qualification_status || 'received',\n    crm_sync_status: fields.crm_sync_status || 'pending',\n    deal_eligible: false,\n    message: 'Lead already exists; no duplicate created.'\n  }\n}];"
      },
