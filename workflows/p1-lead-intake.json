    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst now = new Date().toISOString();\nreturn [{\n  json: {\n    raw_source: 'form',\n    source: 'form',\n    source_event_id: String(j.submissionId || j.submission_id || j.formId || j.formSubmissionId || ''),\n    name: String(j.Name || j.name || '').trim(),\n    email: String(j.Email || j.email || '').trim().toLowerCase(),\n    phone: String(j.Phone || j.phone || '').trim() || null,\n    company: String(j.Company || j.company || '').trim() || null,\n    message: String(j.Message || j.message || j.Comments || j.comments || '').trim(),\n    consent_status: String(j.Consent || j.consent_status || j.consent || 'unknown').trim() || 'unknown',\n    campaign: String(j.Campaign || j.campaign || '').trim() || null,\n    owner_hint: String(j.Owner || j.owner_hint || '').trim() || null,\n    received_at: now\n  }\n}];"
      },
      "id": "p1-intake-normalize-form",
      "name": "Normalize Form Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        -220
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst body = j.body && typeof j.body === 'object' ? j.body : j;\nconst now = new Date().toISOString();\nreturn [{\n  json: {\n    raw_source: 'webhook',\n    source: String(body.source || 'webhook').toLowerCase(),\n    source_event_id: String(body.source_event_id || body.event_id || body.id || body.message_id || ''),\n    name: String(body.name || body.full_name || '').trim(),\n    email: String(body.email || body.email_address || '').trim().toLowerCase(),\n    phone: String(body.phone || body.phone_number || '').trim() || null,\n    company: String(body.company || body.organization || '').trim() || null,\n    message: String(body.message || body.notes || body.comments || '').trim(),\n    consent_status: String(body.consent_status || body.consent || 'unknown').trim() || 'unknown',\n    campaign: String(body.campaign || body.utm_campaign || '').trim() || null,\n    owner_hint: String(body.owner_hint || body.owner || '').trim() || null,\n    received_at: String(body.received_at || body.timestamp || now)\n  }\n}];"
      },
      "id": "p1-intake-normalize-webhook",
      "name": "Normalize Webhook Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst allowedSources = ['form','webhook','gmail','other'];\nconst errors = [];\nconst email = j.email || '';\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nif (!emailOk) errors.push('invalid_email');\nif (!j.name) errors.push('missing_name');\nif (!j.message || j.message.length < 2) errors.push('missing_message');\nconst payloadSize = JSON.stringify(j).length;\nif (payloadSize > 20000) errors.push('payload_too_large');\nconst source = allowedSources.includes(j.source) ? j.source : '';\nif (!source) errors.push('disallowed_source');\nconst hex = () => Math.floor((1 + Math.random()) * 0x100000000).toString(16).slice(1);\nconst correlation_id = hex() + hex() + '-' + hex() + '-' + hex() + '-' + hex() + '-' + hex() + hex() + hex();\nlet idempotencyKey;\nif (j.source_event_id) {\n  idempotencyKey = j.source + ':' + j.source_event_id;\n} else {\n  const raw = (j.email || '') + '|' + (j.message || '') + '|' + (j.source || '');\n  let h = 0x811c9dc5;\n  for (let i = 0; i < raw.length; i++) { h ^= raw.charCodeAt(i); h = (h * 0x01000193) >>> 0; }\n  idempotencyKey = j.source + ':content-' + h.toString(16);\n}\nconst valid = errors.length === 0;\nconst dedupFormula = valid ? '{idempotency_key} = \"' + idempotencyKey + '\"' : '';\nconst canonical = {\n  correlation_id,\n  idempotency_key: idempotencyKey,\n  source: source || j.source || 'other',\n  source_event_id: j.source_event_id || '',\n  received_at: j.received_at,\n  name: j.name,\n  email: email,\n  phone: j.phone || null,\n  company: j.company || null,\n  message: j.message || '',\n  consent_status: j.consent_status || 'unknown',\n  campaign: j.campaign || null,\n  owner_hint: j.owner_hint || null\n};\nreturn [{ json: { valid, errors, dedup_formula: dedupFormula, lead: canonical } }];"
      },
