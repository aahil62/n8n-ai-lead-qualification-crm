    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "authentication": "predefinedCredentialType",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filterGroups: [{ filters: [{ value: $('Prepare CRM Input').item.json.email, propertyName: 'email', operator: 'EQ' }] }], properties: ['email','firstname','lastname','company'] }) }}",
        "options": {
          "response": {
            "fullResponse": true,
            "neverError": true
          }
        },
        "nodeCredentialType": "hubspotAppToken"
      },
      "id": "p1-crm-search-contact",
      "name": "Search HubSpot Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        20,
        0
      ],
      "notes": "HubSpot OAuth2 credential bound by a controlled test run. neverError + fullResponse so status codes are classified in code, not thrown.",
      "continueOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Prepare CRM Input').item.json;\nconst resp = $input.first().json;\nconst err = resp.error || {};\nconst errText = String(err.message || resp.message || '');\nconst status = Number(resp.statusCode || resp.status || err.httpCode || err.statusCode || (/auth|api key|unauthor/i.test(errText) ? 401 : (errText ? 500 : 200)));\nconst body = resp.body || resp;\nconst results = (body && body.results) || [];\nconst existing = results[0];\nconst contactId = existing ? existing.id : null;\nlet action = 'create';\nif (status >= 400) action = 'error';\nelse if (contactId) action = 'update';\nreturn [{ json: { ...lead, contact_action: action, contact_id: contactId, search_status: status } }];"
      },
      "id": "p1-crm-resolve-contact",
      "name": "Resolve Contact",
