            "sanitized_input": "={{ JSON.stringify({ idempotency_key: $('Mark Notification Result').item.json.idempotency_key, lead_id: $('Mark Notification Result').item.json.lead_id, crm_deal_id: $('Mark Notification Result').item.json.deal_id }).slice(0, 2000) }}",
            "error_code": "notification_failed",
