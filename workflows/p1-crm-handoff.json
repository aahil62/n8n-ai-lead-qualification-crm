        4380,
        -40
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "notes": "Notification failure is recorded independently so it can be replayed without touching the already-synced deal (P1-E2E-012)."
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Mark Notification Result').item.json;\nreturn [{ json: {\n  correlation_id: lead.correlation_id,\n  idempotency_key: lead.idempotency_key,\n  lead_id: lead.lead_id,\n  crm_sync_status: 'synced',\n  crm_contact_id: lead.contact_id,\n  crm_company_id: lead.company_id,\n  crm_deal_id: lead.deal_id,\n  notification_status: lead.notification_status,\n  deal_created: true,\n  outcome: 'crm_handoff_success'\n}}];"
      },
      "id": "p1-crm-return-ok",
      "name": "Return CRM Handoff Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4620,
        -160
      ]
    },
    {
      "parameters": {
        "jsCode": "const incoming = $input.first().json || {};\nconst resolve = $('Resolve Contact').item.json || {};\nlet status = incoming.contact_status || incoming.deal_status || incoming.search_status || resolve.search_status || 0;\nlet error_class = incoming.error_class || '';\nlet error_code = incoming.error_code || '';\nif (!error_class) {\n  if (status === 401 || status === 403) error_class = 'auth';\n  else if (status === 429 || status >= 500) error_class = 'transient';\n  else if (status >= 400) error_class = 'transient';\n  else error_class = 'transient';\n}\nif (!error_code) error_code = status ? ('http_' + status) : 'crm_failure';\nreturn [{ json: { ...resolve, ...incoming, error_class, error_code, failure_status: status } }];"
      },
      "id": "p1-crm-fail-handler",
