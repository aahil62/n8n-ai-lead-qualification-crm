    {
      "parameters": {
        "jsCode": "const lead = $('Capture Contact ID').item.json;\nconst resp = $input.first().json;\nconst status = resp.statusCode || resp.status || 200;\nconst body = resp.body || resp;\nconst results = (body && body.results) || [];\nconst existing = results[0];\nconst companyId = existing ? existing.id : null;\nlet action = 'skip';\nif (status >= 400) action = 'skip';\nelse if (!companyId && lead.company_name) action = 'create';\nreturn [{ json: { ...lead, company_action: action, company_id: companyId, company_search_status: status } }];"
      },
