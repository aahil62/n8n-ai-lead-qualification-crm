      "parameters": {
        "jsCode": "const lead = $('Resolve Company').item.json;\nconst resp = $input.first().json;\nconst status = resp.statusCode || resp.status || 200;\nconst body = resp.body || resp;\nlet companyId = lead.company_id;\nif (body && body.id) companyId = body.id;\nconst companyStatus = lead.company_action === 'create' ? status : (lead.company_search_status || 200);\nreturn [{ json: { ...lead, company_id: companyId || '', company_status: companyStatus } }];"
      },
      "id": "p1-crm-capture-company",
      "name": "Capture Company ID",
      "type": "n8n-nodes-base.code",
