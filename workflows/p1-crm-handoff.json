        "jsonBody": "={{ JSON.stringify({ filterGroups: [{ filters: [{ value: $('Prepare CRM Input').item.json.company_name, propertyName: 'name', operator: 'EQ' }] }], properties: ['name','domain'] }) }}",
        "options": {
