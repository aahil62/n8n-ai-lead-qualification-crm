{
  "name": "P1-03 CRM Handoff",
  "nodes": [
    {
      "parameters": {
        "description": "Accepts a qualified lead decision from P1-01/P1-02. Upserts HubSpot contact, company, and deal, verifies returned IDs, then updates Airtable lead state. Existing_customer/spam/low-confidence leads never reach this workflow.",
        "inputSource": "passthrough",
        "returnOutput": "lastRunOnly"
      },
      "id": "p1-crm-trigger",
      "name": "On CRM Handoff Request",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -700,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst parts = String(j.name || '').trim().split(/\\s+/);\nconst firstname = parts[0] || '';\nconst lastname = parts.slice(1).join(' ') || '';\nconst contact_properties = { email: j.email, firstname, lastname, company: j.company || '', phone: j.phone || '', lifecyclestage: 'lead' };\nconst deal_properties = { dealname: 'Lead: ' + (j.company || j.name || j.email), dealstage: 'qualifiedtobuy', pipeline: 'default' };\nreturn [{ json: { ...j, contact_properties, deal_properties, company_name: j.company || '' } }];"
      },
      "id": "p1-crm-prepare",
      "name": "Prepare CRM Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        0
      ]
    },
    {
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "update",
        "base": {
          "__rl": true,
          "value": "REPLACE-AIRTABLE-BASE-ID",
          "mode": "id"
        },
