    {
      "parameters": {
        "jsCode": "const lead = $('Capture Company ID').item.json;\nconst associations = [{ to: { id: lead.contact_id }, types: [{ associationCategory: 'HUBSPOT_DEFINED', associationTypeId: 3 }] }];\nif (lead.company_id) associations.push({ to: { id: lead.company_id }, types: [{ associationCategory: 'HUBSPOT_DEFINED', associationTypeId: 5 }] });\nconst deal_body = { properties: lead.deal_properties, associations };\nreturn [{ json: { ...lead, deal_body } }];"
      },
