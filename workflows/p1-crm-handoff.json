    {
      "parameters": {
        "jsCode": "const lead = $('Resolve Contact').item.json;\nconst resp = $input.first().json;\nconst status = resp.statusCode || resp.status || 200;\nconst body = resp.body || resp;\nlet contactId = lead.contact_id;\nif (body && body.id) contactId = body.id;\nreturn [{ json: { ...lead, contact_id: contactId, contact_status: status } }];"
      },
