      "id": "p1-crm-create-deal",
      "name": "Create HubSpot Deal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2700,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Deal is associated with the verified contact (and company when present). Live-verified HubSpot associationTypeIds: 3 (deal-to-contact) and 5 (deal-to-company).",
      "continueOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Capture Company ID').item.json;\nconst dealResp = $input.first().json;\nconst dealStatus = dealResp.statusCode || dealResp.status || 200;\nconst dealBody = dealResp.body || dealResp;\nlet dealId = (dealBody && dealBody.id) || null;\nconst contactId = lead.contact_id;\nconst contactStatus = lead.contact_status || 200;\nlet verified = true;\nlet error_code = '';\nlet error_class = '';\nconst code = Math.max(contactStatus, dealStatus);\nif (code >= 400) {\n  verified = false;\n  if (code === 401 || code === 403) { error_code = 'auth_error'; error_class = 'auth'; }\n  else if (code === 429 || code >= 500) { error_code = 'transient'; error_class = 'transient'; }\n  else { error_code = 'http_' + code; error_class = 'transient'; }\n}\nif (verified && (!contactId || !dealId)) { verified = false; error_code = 'missing_external_ids'; error_class = 'transient'; }\nreturn [{ json: { ...lead, contact_id: contactId, deal_id: dealId, contact_status: contactStatus, deal_status: dealStatus, verified, error_code, error_class } }];"
      },
