    {
      "parameters": {
        "authentication": "accessToken",
        "resource": "task",
        "operation": "create",
        "workspace": "REPLACE-ASANA-WORKSPACE-ID",
        "name": "={{ 'Qualified lead: ' + ($('Verify CRM Result').item.json.company || $('Verify CRM Result').item.json.name) + ' (' + $('Verify CRM Result').item.json.temperature + ', score ' + $('Verify CRM Result').item.json.score + ')' }}",
        "otherProperties": {
          "projects": [
            "REPLACE-ASANA-PROJECT-ID"
          ],
          "notes": "=Lead: {{ $('Verify CRM Result').item.json.name }} ({{ $('Verify CRM Result').item.json.email }})\nCompany: {{ $('Verify CRM Result').item.json.company }}\nTemperature: {{ $('Verify CRM Result').item.json.temperature }} (score {{ $('Verify CRM Result').item.json.score }})\nIntent: {{ $('Verify CRM Result').item.json.intent }}\nSource: {{ $('Verify CRM Result').item.json.source }}\nOwner: {{ $('Verify CRM Result').item.json.owner_id }}\n\nSummary: {{ $('Verify CRM Result').item.json.summary }}\n\nHubSpot contact: {{ $('Verify CRM Result').item.json.contact_id }}\nHubSpot company: {{ $('Verify CRM Result').item.json.company_id }}\nHubSpot deal: {{ $('Verify CRM Result').item.json.deal_id }}\n\nBooking: {{ $('Verify CRM Result').item.json.calendar_link }}"
        }
      },
      "id": "p1-crm-notify",
      "name": "Notify Sales Owner",
      "type": "n8n-nodes-base.asana",
      "typeVersion": 1,
      "position": [
        3660,
        -160
      ],
      "continueOnFail": true,
      "notes": "Alerts the routed sales owner. continueOnFail so a notification failure cannot erase the already-synced deal."
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Verify CRM Result').item.json;\nconst resp = $input.first().json;\nlet notify_ok = true;\nif (resp && resp.error) notify_ok = false;\nelse if (resp && resp.json && resp.json.errors) notify_ok = false;\nelse if (resp && resp.statusCode && resp.statusCode >= 400) notify_ok = false;\nreturn [{ json: { ...lead, notification_status: notify_ok ? 'sent' : 'failed', deal_unchanged: true } }];"
      },
